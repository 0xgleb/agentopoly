{
  "name": "agentopoly",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "prettier --check --ignore-unknown .",
    "format:write": "prettier --write --ignore-unknown .",
    "start": "bun run index.ts",
    "lint": "eslint .",
    "typecheck:runtime": "tsc --noEmit",
    "typecheck": "bun run typecheck:runtime && tsc --project test/tsconfig.json",
    "test:unit": "bun test --timeout 10000 test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test": "bun run test:unit && bun run test:integration",
    "build": "bun build --target=bun --packages=external --root=. --outdir=dist index.ts participant/worker.js",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "5",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@tetherto/wdk": "^1.0.0-beta.16",
    "@tetherto/wdk-cli": "1.0.0-beta.3",
    "effect": "^3.22.1",
    "hyperswarm": "^4.17.0",
    "pear-runtime": "^1.3.1"
  }
}
